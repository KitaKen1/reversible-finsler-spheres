module

public import Finsler.Analysis.PseudoGradient
public import Finsler.Analysis.SphereFlow

/-! Equivariant pseudo-gradient fields and flows. Let r and h be commuting involutive continuous
linear maps of a normed space E, and f a function invariant under both. For a field V, the average
of g ∘ V ∘ g over the four elements g of the group generated by r and h commutes with r and h. If f
is differentiable at the points of an open set O invariant under r and h, then the derivative of f
in the direction of the average field at y ∈ O is the average of the derivatives in the direction
of V at the points g y; so the average of a pseudo-gradient field of f on O (nonpositive derivative
on O, negative on an invariant set A) is again one, smooth with compact support in O if V is. The
global solution of an ODE whose field commutes with a continuous linear map L commutes with L
(uniqueness of solutions). Hence the flow of the average field commutes with r and h. -/

@[expose] public section

namespace Finsler.EquivariantField

open Set Filter Topology
open scoped ContDiff NNReal

noncomputable section

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- The global solution of an ODE commutes with a continuous linear map commuting with the
field. -/
theorem globalSolution_map [CompleteSpace E] (v : E → E) {K : ℝ≥0} (hv : LipschitzWith K v)
    (L : E →L[ℝ] E) (hL : ∀ y, v (L y) = L (v y)) (x : E) (t : ℝ) :
    ODE.globalSolution v hv (L x) t = L (ODE.globalSolution v hv x t) := by
  have hder : ∀ s, HasDerivAt (fun s => L (ODE.globalSolution v hv x s))
      (v ((fun s => L (ODE.globalSolution v hv x s)) s)) s := by
    intro s
    have h := L.hasFDerivAt.comp_hasDerivAt s (ODE.hasDerivAt_globalSolution v hv x s)
    rw [hL]
    exact h
  have h := ODE.eq_globalSolution v hv hder
  have h0 : L (ODE.globalSolution v hv x 0) = L x := by rw [ODE.globalSolution_zero]
  rw [h0] at h
  exact (congrFun h t).symm

variable (r h : E →L[ℝ] E)

/-- The average of a field over the group generated by two commuting involutions. -/
def avg (V : E → E) (x : E) : E :=
  (1 / 4 : ℝ) • (V x + r (V (r x)) + h (V (h x)) + r (h (V (r (h x)))))

variable {r h} (hr : ∀ x, r (r x) = x) (hh : ∀ x, h (h x) = x) (hrh : ∀ x, r (h x) = h (r x))

include hr hrh in
theorem avg_r (V : E → E) (x : E) : avg r h V (r x) = r (avg r h V x) := by
  unfold avg
  rw [hr x, hrh (r x), hr x, map_smul, map_add, map_add, map_add, hr (V (r x)),
    hr (h (V (r (h x)))), hrh x]
  congr 1
  abel

include hh hrh in
theorem avg_h (V : E → E) (x : E) : avg r h V (h x) = h (avg r h V x) := by
  unfold avg
  rw [hh x, map_smul, map_add, map_add, map_add, hh (V (h x)), ← hrh (V (r x)),
    ← hrh (h (V (r (h x)))), hh (V (r (h x)))]
  congr 1
  abel

variable {f : E → ℝ}

omit hr hh hrh in
/-- The derivative of a function invariant under an involutive continuous linear map g, in the
direction of g w, is its derivative at g y in the direction w. -/
theorem fderiv_inv (g : E →L[ℝ] E) (hg : ∀ x, g (g x) = x) (hfg : ∀ x, f (g x) = f x) {y w : E}
    (hd : DifferentiableAt ℝ f (g y)) : fderiv ℝ f y (g w) = fderiv ℝ f (g y) w := by
  have hcomp : f = f ∘ g := funext fun x => (hfg x).symm
  have hfd : HasFDerivAt (f ∘ g) ((fderiv ℝ f (g y)).comp g) y :=
    hd.hasFDerivAt.comp y g.hasFDerivAt
  rw [← hcomp] at hfd
  rw [hfd.fderiv]
  simp [hg]

/-- The homeomorphism of an involutive continuous linear map. -/
def invHomeo (g : E →L[ℝ] E) (hg : ∀ x, g (g x) = x) : E ≃ₜ E where
  toFun := g
  invFun := g
  left_inv := hg
  right_inv := hg
  continuous_toFun := g.continuous
  continuous_invFun := g.continuous

include hr hh hrh in
/-- **Equivariant pseudo-gradient fields.** For a function C¹ on an open set O, invariant under
two commuting involutive continuous linear maps r and h which preserve O and a compact set
A ⊆ O on which the derivative does not vanish, there is a smooth field with compact support in O,
commuting with r and h, along which the derivative of the function is nonpositive on O and
negative on A. -/
theorem exists_pseudoGradient_equivariant [FiniteDimensional ℝ E] (hfr : ∀ x, f (r x) = f x)
    (hfh : ∀ x, f (h x) = f x) {O : Set E} (hO : IsOpen O) (hf : ContDiffOn ℝ 1 f O)
    (hOr : ∀ x ∈ O, r x ∈ O) (hOh : ∀ x ∈ O, h x ∈ O) {A : Set E} (hA : IsCompact A)
    (hAO : A ⊆ O) (hAr : ∀ x ∈ A, r x ∈ A) (hAh : ∀ x ∈ A, h x ∈ A)
    (hne : ∀ x ∈ A, fderiv ℝ f x ≠ 0) :
    ∃ V : E → E, ContDiff ℝ ∞ V ∧ HasCompactSupport V ∧ (∀ x, V x ≠ 0 → x ∈ O) ∧
      (∀ y ∈ O, fderiv ℝ f y (V y) ≤ 0) ∧ (∀ y ∈ A, fderiv ℝ f y (V y) < 0) ∧
      (∀ x, V (r x) = r (V x)) ∧ (∀ x, V (h x) = h (V x)) := by
  obtain ⟨V, hVs, hVc, hVt, hVle, hVlt⟩ :=
    Finsler.PseudoGradient.exists_pseudoGradient hO hf hA hAO hne
  set g := r.comp h with hgdef
  have hg : ∀ x, g (g x) = x := fun x => by
    change r (h (r (h x))) = x
    rw [← hrh (h x), hh, hr]
  have hfg : ∀ x, f (g x) = f x := fun x => by
    change f (r (h x)) = f x
    rw [hfr, hfh]
  have hOg : ∀ x ∈ O, g x ∈ O := fun x hx => hOr _ (hOh x hx)
  have hAg : ∀ x ∈ A, g x ∈ A := fun x hx => hAr _ (hAh x hx)
  have hdiff : ∀ y ∈ O, DifferentiableAt ℝ f y := fun y hy =>
    ((hf y hy).contDiffAt (hO.mem_nhds hy)).differentiableAt one_ne_zero
  have hsuppV : ∀ x, V x ≠ 0 → x ∈ O := fun x hx => hVt (subset_tsupport V hx)
  have havg : ∀ x, avg r h V x =
      (1 / 4 : ℝ) • (V x + r (V (r x)) + h (V (h x)) + g (V (g x))) := fun x => rfl
  refine ⟨avg r h V, ?_, ?_, ?_, ?_, ?_, avg_r hr hrh V, avg_h hh hrh V⟩
  · have h1 : ContDiff ℝ ∞ fun x => r (V (r x)) := r.contDiff.comp (hVs.comp r.contDiff)
    have h2 : ContDiff ℝ ∞ fun x => h (V (h x)) := h.contDiff.comp (hVs.comp h.contDiff)
    have h3 : ContDiff ℝ ∞ fun x => g (V (g x)) := g.contDiff.comp (hVs.comp g.contDiff)
    exact contDiff_const.smul (((hVs.add h1).add h2).add h3)
  · have hc : ∀ (k : E →L[ℝ] E) (hk : ∀ x, k (k x) = x),
        HasCompactSupport fun x => k (V (k x)) := fun k hk =>
      (hVc.comp_homeomorph (invHomeo k hk)).comp_left (map_zero k)
    exact ((((hVc.add (hc r hr)).add (hc h hh)).add (hc g hg))).smul_left
  · intro x hx
    rw [havg] at hx
    by_contra hxO
    apply hx
    have h0 : V x = 0 := by
      by_contra h0
      exact hxO (hsuppV x h0)
    have hz : ∀ (k : E →L[ℝ] E), (∀ x, k (k x) = x) → (∀ x ∈ O, k x ∈ O) → k (V (k x)) = 0 :=
      fun k hk hkO => by
        by_contra hne
        have : V (k x) ≠ 0 := fun h' => hne (by rw [h', map_zero])
        exact hxO (by rw [← hk x]; exact hkO _ (hsuppV _ this))
    rw [h0, hz r hr hOr, hz h hh hOh, hz g hg hOg, add_zero, add_zero, add_zero, smul_zero]
  · intro y hy
    rw [havg, map_smul, map_add, map_add, map_add, fderiv_inv r hr hfr (hdiff _ (hOr y hy)),
      fderiv_inv h hh hfh (hdiff _ (hOh y hy)), fderiv_inv g hg hfg (hdiff _ (hOg y hy)),
      smul_eq_mul]
    have := hVle y hy
    have := hVle _ (hOr y hy)
    have := hVle _ (hOh y hy)
    have := hVle _ (hOg y hy)
    nlinarith
  · intro y hy
    rw [havg, map_smul, map_add, map_add, map_add, fderiv_inv r hr hfr (hdiff _ (hOr y (hAO hy))),
      fderiv_inv h hh hfh (hdiff _ (hOh y (hAO hy))), fderiv_inv g hg hfg (hdiff _ (hOg y (hAO hy))),
      smul_eq_mul]
    have := hVlt y hy
    have := hVlt _ (hAr y hy)
    have := hVlt _ (hAh y hy)
    have := hVlt _ (hAg y hy)
    nlinarith

end

end Finsler.EquivariantField
