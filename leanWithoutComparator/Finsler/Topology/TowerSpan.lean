module

public import Finsler.Topology.NilpotentW
public import Finsler.Topology.BorelQuasiIso

/-! The tower lemma: reflection Borel cohomology from ordinary dimensions and tower ends.

For an involutive cochain complex K the Gysin sequence
B^{q−1} →w→ B^q →forget→ A^q →transfer→ B^q →w→ B^{q+1}, with B = H_R(K) and A = H(K), is exact.
Let S be a set of degrees with classes x_s ∈ B^s, and define the towers recursively by
T_0 = ⟨x_0⟩ (if 0 ∈ S) and T_{q+1} = w(T_q) + ⟨x_{q+1}⟩ (if q + 1 ∈ S). Suppose that in every
degree q, dim A^q ≤ 1, and one of the following holds:

* q ∈ S and forget(x_q) ≠ 0 (a tower starts);
* some nonzero t ∈ B^q has w t = 0 (a tower ends);
* A^q = 0.

Then B^q = T_q in every degree. At a start, forget(y) is a multiple of forget(x_q), so y − c x_q
comes from B^{q−1}. At an end, t is the transfer of a nonzero z, which spans A^q; forget(y) = c z
and transfer ∘ forget = 0 give c t = 0, so c = 0 and y comes from B^{q−1}. Otherwise forget(y) = 0.
In degree zero forget is injective. Only spanning is proved, no independence: this is what the
basis interface needs, and the starts and ends come from lower bounds alone. -/

@[expose] public section

namespace Finsler.TowerSpan

open Finsler.BorelCochain Module

noncomputable section

variable (K : InvComplex) (S : Set ℕ) [DecidablePred (· ∈ S)] (x : (s : ℕ) → HR K s)

/-- The towers generated by the classes x_s, s ∈ S. -/
def tower : (q : ℕ) → Submodule (ZMod 2) (HR K q)
  | 0 => if 0 ∈ S then Submodule.span (ZMod 2) {x 0} else ⊥
  | q + 1 => Submodule.map (w K q) (tower q) ⊔
      (if q + 1 ∈ S then Submodule.span (ZMod 2) {x (q + 1)} else ⊥)

theorem tower_zero : tower K S x 0 = if 0 ∈ S then Submodule.span (ZMod 2) {x 0} else ⊥ := rfl

theorem tower_succ (q : ℕ) : tower K S x (q + 1) = Submodule.map (w K q) (tower K S x q) ⊔
    (if q + 1 ∈ S then Submodule.span (ZMod 2) {x (q + 1)} else ⊥) := rfl

theorem mem_start {q : ℕ} (hq : q ∈ S) : x q ∈ tower K S x q := by
  cases q with
  | zero =>
    rw [tower_zero, if_pos hq]
    exact Submodule.subset_span rfl
  | succ q =>
    rw [tower_succ, if_pos hq]
    exact Submodule.mem_sup_right (Submodule.subset_span rfl)

theorem mem_w {q : ℕ} {y : HR K q} (hy : y ∈ tower K S x q) : w K q y ∈ tower K S x (q + 1) := by
  rw [tower_succ]
  exact Submodule.mem_sup_left (Submodule.mem_map_of_mem hy)

/-- In a space of dimension at most one every vector is a multiple of a nonzero vector. -/
theorem exists_smul_of_finrank_le_one {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) V] (hV : finrank (ZMod 2) V ≤ 1) {v : V} (hv : v ≠ 0) (y : V) :
    ∃ c : ZMod 2, y = c • v := by
  have hpos : 0 < finrank (ZMod 2) V := Module.finrank_pos_iff_exists_ne_zero.mpr ⟨v, hv⟩
  have h1 : finrank (ZMod 2) V = 1 := le_antisymm hV hpos
  obtain ⟨c, hc⟩ := (finrank_eq_one_iff_of_nonzero' v hv).mp h1 y
  exact ⟨c, hc.symm⟩

variable {K S x}

/-- One degree of the tower lemma: if every class with vanishing forgetful image lies in the
tower, every class does. -/
theorem mem_of_forget (hfin : ∀ q, FiniteDimensional (ZMod 2) (H K q))
    (hdim : ∀ q, finrank (ZMod 2) (H K q) ≤ 1)
    (hcase : ∀ q, (q ∈ S ∧ forget K q (x q) ≠ 0) ∨ (∃ t : HR K q, t ≠ 0 ∧ w K q t = 0) ∨
      (∀ z : H K q, z = 0))
    (q : ℕ) (hfrom : ∀ y : HR K q, forget K q y = 0 → y ∈ tower K S x q) (y : HR K q) :
    y ∈ tower K S x q := by
  have := hfin q
  rcases hcase q with ⟨hS, hx⟩ | ⟨t, ht, hwt⟩ | hz
  · obtain ⟨c, hc⟩ := exists_smul_of_finrank_le_one (hdim q) hx (forget K q y)
    have h0 : forget K q (y - c • x q) = 0 := by
      rw [map_sub, map_smul, hc, sub_self]
    have hy : y = (y - c • x q) + c • x q := by abel
    rw [hy]
    exact Submodule.add_mem _ (hfrom _ h0) (Submodule.smul_mem _ c (mem_start K S x hS))
  · obtain ⟨z, hz⟩ := (exact_w K q t).mp hwt
    have hz0 : z ≠ 0 := by
      rintro rfl
      rw [map_zero] at hz
      exact ht hz.symm
    obtain ⟨c, hc⟩ := exists_smul_of_finrank_le_one (hdim q) hz0 (forget K q y)
    have htr : transfer K q (forget K q y) = 0 := (exact_transfer K q _).mpr ⟨y, rfl⟩
    rw [hc, map_smul, hz] at htr
    have hc0 : c = 0 := by
      by_contra hne
      have h1 : c = 1 := by
        fin_cases c
        · exact absurd rfl hne
        · rfl
      rw [h1, one_smul] at htr
      exact ht htr
    rw [hc0, zero_smul] at hc
    exact hfrom y hc
  · exact hfrom y (hz _)

/-- The tower lemma: the reflection Borel cohomology is spanned by the towers. -/
theorem eq_tower (hfin : ∀ q, FiniteDimensional (ZMod 2) (H K q))
    (hdim : ∀ q, finrank (ZMod 2) (H K q) ≤ 1)
    (hcase : ∀ q, (q ∈ S ∧ forget K q (x q) ≠ 0) ∨ (∃ t : HR K q, t ≠ 0 ∧ w K q t = 0) ∨
      (∀ z : H K q, z = 0)) :
    ∀ q (y : HR K q), y ∈ tower K S x q := by
  intro q
  induction q with
  | zero =>
    apply mem_of_forget hfin hdim hcase 0
    intro y hy
    have h : y = 0 := BorelQuasiIso.forget_zero_injective K (by rw [map_zero]; exact hy)
    rw [h]
    exact Submodule.zero_mem _
  | succ q ih =>
    apply mem_of_forget hfin hdim hcase (q + 1)
    intro y hy
    obtain ⟨y', rfl⟩ := (exact_forget K q y).mp hy
    exact mem_w K S x (ih y')

end

end Finsler.TowerSpan
