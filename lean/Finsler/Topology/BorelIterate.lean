module

public import Finsler.Topology.BorelCochain

/-! Iterated Borel cochains for two commuting involutions. If s is a second cochain involution
commuting with the differential and with t, it acts componentwise on the t-Borel cochains and
commutes with the Borel differential, so the t-Borel complex is again an involutive cochain
complex. Its ordinary cohomology is the t-Borel cohomology, and its s-Borel cohomology is the
Borel cohomology for the group generated by s and t; the Gysin sequence of this second
construction is the sign sequence relating the two. If t is the identity, (1 + t) = 0 and the
t-Borel cochains split as the direct sum of shifted copies of the cochains. -/

@[expose] public section

namespace Finsler.BorelIterate

open Finsler.BorelCochain

noncomputable section

/-- A second involution commuting with the differential and with the first involution. -/
structure Commuting (K : InvComplex) where
  s : ∀ j, K.C j →ₗ[ZMod 2] K.C j
  ss : ∀ j x, s j (s j x) = x
  sd : ∀ j x, s (j + 1) (K.d j x) = K.d j (s j x)
  st : ∀ j x, s j (K.t j x) = K.t j (s j x)

variable {K : InvComplex} (S : Commuting K)

/-- The componentwise action on total cochains. -/
def seqS : Seq K →ₗ[ZMod 2] Seq K := LinearMap.pi fun j => S.s j ∘ₗ LinearMap.proj j

theorem seqS_apply (c : Seq K) (j : ℕ) : seqS S c j = S.s j (c j) := rfl

theorem seqS_seqS (c : Seq K) : seqS S (seqS S c) = c := by
  funext j
  exact S.ss j (c j)

theorem s_tr (j : ℕ) (x : K.C j) : S.s j (tr K j x) = tr K j (S.s j x) := by
  rw [tr_apply, tr_apply, map_add, S.st]

theorem seqS_D (c : Seq K) : seqS S (D K c) = D K (seqS S c) := by
  funext j
  cases j with
  | zero =>
    rw [seqS_apply, D_zero, D_zero, s_tr]
    rfl
  | succ j =>
    rw [seqS_apply, D_succ, D_succ, map_add, S.sd, s_tr]
    rfl

theorem seqS_low {k : ℕ} {c : Seq K} (hc : c ∈ low K k) : seqS S c ∈ low K k := by
  intro j hj
  rw [seqS_apply, hc j hj, map_zero]

/-- The t-Borel complex with the componentwise involution s. -/
def borelInv : InvComplex where
  C n := low K (n + 1)
  d _ := (D K).restrict (fun _ hc => D_mem_low K hc)
  t _ := (seqS S).restrict (fun _ hc => seqS_low S hc)
  dd _ x := Subtype.ext (D_D K (x : Seq K))
  tt _ x := Subtype.ext (seqS_seqS S (x : Seq K))
  td _ x := Subtype.ext (seqS_D S (x : Seq K))

/-- The underlying Borel cochain. -/
def toLow (n : ℕ) (x : (borelInv S).C n) : low K (n + 1) := x

/-- A Borel cochain as a cochain of the t-Borel complex. -/
def ofLow (n : ℕ) (x : low K (n + 1)) : (borelInv S).C n := x

theorem toLow_d (n : ℕ) (x : (borelInv S).C n) :
    ((toLow S (n + 1) ((borelInv S).d n x) : low K (n + 1 + 1)) : Seq K) =
      D K ((toLow S n x : low K (n + 1)) : Seq K) := rfl

/-- Ordinary cocycles of the t-Borel complex are Borel cocycles. -/
theorem mem_cocycles_borelInv (n : ℕ) (x : (borelInv S).C n) :
    x ∈ cocycles (borelInv S) n ↔ ((toLow S n x : low K (n + 1)) : Seq K) ∈ bcocycles K n := by
  constructor
  · intro h
    refine ⟨(toLow S n x).2, ?_⟩
    have h' : (borelInv S).d n x = 0 := h
    have h'' := congrArg (fun y => ((toLow S (n + 1) y : low K (n + 1 + 1)) : Seq K)) h'
    exact h''
  · intro h
    have h1 : D K ((toLow S n x : low K (n + 1)) : Seq K) = 0 := ((mem_bcocycles K).mp h).2
    change (borelInv S).d n x = 0
    exact Subtype.ext h1

/-- Ordinary coboundaries of the t-Borel complex are Borel coboundaries. -/
theorem mem_coboundaries_borelInv (n : ℕ) (x : (borelInv S).C n) :
    x ∈ coboundaries (borelInv S) n ↔
      ((toLow S n x : low K (n + 1)) : Seq K) ∈ bcoboundaries K n := by
  cases n with
  | zero =>
    constructor
    · intro h
      have h0 : x = 0 := h
      rw [h0]
      exact Submodule.zero_mem _
    · rintro ⟨b, hb, hbx⟩
      have hb0 : b = 0 := mem_low_zero K hb
      change x = 0
      apply Subtype.ext
      change ((toLow S 0 x : low K (0 + 1)) : Seq K) = 0
      rw [← hbx, hb0, map_zero]
  | succ m =>
    constructor
    · rintro ⟨y, rfl⟩
      exact ⟨((toLow S m y : low K (m + 1)) : Seq K), (toLow S m y).2, rfl⟩
    · rintro ⟨b, hb, hbx⟩
      exact ⟨ofLow S m ⟨b, hb⟩, Subtype.ext hbx⟩

/-- The comparison of cocycles. -/
def cocycleEquiv (n : ℕ) : cocycles (borelInv S) n ≃ₗ[ZMod 2] bcocycles K n where
  toFun x := ⟨((toLow S n x.1 : low K (n + 1)) : Seq K), (mem_cocycles_borelInv S n x.1).mp x.2⟩
  invFun c := ⟨ofLow S n ⟨(c : Seq K), ((mem_bcocycles K).mp c.2).1⟩,
    (mem_cocycles_borelInv S n _).mpr c.2⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl
  left_inv _ := rfl
  right_inv _ := rfl

/-- The ordinary cohomology of the t-Borel complex is the t-Borel cohomology. -/
def cohomologyEquiv (n : ℕ) : H (borelInv S) n ≃ₗ[ZMod 2] HR K n :=
  Submodule.Quotient.equiv _ _ (cocycleEquiv S n) (by
    ext c
    constructor
    · rintro ⟨x, hx, rfl⟩
      exact (mem_coboundaries_borelInv S n x.1).mp hx
    · intro hc
      refine ⟨(cocycleEquiv S n).symm c, ?_, (cocycleEquiv S n).apply_symm_apply c⟩
      exact (mem_coboundaries_borelInv S n _).mpr hc)

section Hom

/-- Equivariant maps commuting with the second involutions. -/
structure CommHom {K L : InvComplex} (SK : Commuting K) (SL : Commuting L) where
  φ : InvHom K L
  comm_s : ∀ j x, φ.f j (SK.s j x) = SL.s j (φ.f j x)

variable {K L : InvComplex} {SK : Commuting K} {SL : Commuting L}

/-- The induced map of t-Borel complexes, equivariant for the second involutions. -/
def borelHom (Φ : CommHom SK SL) : InvHom (borelInv SK) (borelInv SL) where
  f _ := (seqMap Φ.φ).restrict (fun _ hc => seqMap_low Φ.φ hc)
  comm_d n x := Subtype.ext (seqMap_D Φ.φ ((toLow SK n x : low K (n + 1)) : Seq K))
  comm_t _ _ := Subtype.ext (funext fun j => Φ.comm_s j _)

theorem borelHom_coe (Φ : CommHom SK SL) (n : ℕ) (x : (borelInv SK).C n) :
    ((toLow SL n ((borelHom Φ).f n x) : low L (n + 1)) : Seq L) =
      seqMap Φ.φ ((toLow SK n x : low K (n + 1)) : Seq K) := rfl

/-- The forgetful identification is natural. -/
theorem cohomologyEquiv_natural (Φ : CommHom SK SL) (n : ℕ) (z : H (borelInv SK) n) :
    cohomologyEquiv SL n (Hmap (borelHom Φ) n z) = HRmap Φ.φ n (cohomologyEquiv SK n z) := by
  obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ z
  rfl

end Hom

section Trivial

variable (K : InvComplex) (htriv : ∀ j x, K.t j x = x)

include htriv in
theorem tr_eq_zero_of_trivial (j : ℕ) (x : K.C j) : tr K j x = 0 := by
  rw [tr_apply, htriv, two_eq_zero_of_mod]

include htriv in
/-- For the trivial involution every component of a Borel cocycle is a cocycle. -/
theorem comp_cocycle_of_trivial {n : ℕ} (c : bcocycles K n) (j : ℕ) :
    K.d j ((c : Seq K) j) = 0 := by
  have h1 : D K (c : Seq K) (j + 1) = 0 := by
    rw [((mem_bcocycles K).mp c.2).2]
    rfl
  rw [D_succ, tr_eq_zero_of_trivial K htriv, add_zero] at h1
  exact h1

/-- The components of a Borel cocycle for the trivial involution. -/
def compCocycle (n : ℕ) (j : ℕ) : bcocycles K n →ₗ[ZMod 2] cocycles K j where
  toFun c := ⟨(c : Seq K) j, comp_cocycle_of_trivial K htriv c j⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

theorem compCocycle_coboundary (n j : ℕ) :
    (bcoboundaries K n).comap (bcocycles K n).subtype ≤
      ((coboundaries K j).comap (cocycles K j).subtype).comap (compCocycle K htriv n j) := by
  rintro c ⟨b, hb, hbc⟩
  have hbc' : D K b = (c : Seq K) := hbc
  change (c : Seq K) j ∈ coboundaries K j
  rw [← hbc']
  cases j with
  | zero =>
    rw [D_zero, tr_eq_zero_of_trivial K htriv]
    exact Submodule.zero_mem _
  | succ i =>
    rw [D_succ, tr_eq_zero_of_trivial K htriv, add_zero]
    exact ⟨b i, rfl⟩

/-- The degree-j component of a Borel class for the trivial involution. -/
def comp (n j : ℕ) : HR K n →ₗ[ZMod 2] H K j :=
  Submodule.mapQ _ _ (compCocycle K htriv n j) (compCocycle_coboundary K htriv n j)

/-- The splitting map H_R^n → ∏_{j ≤ n} H^j. -/
def split (n : ℕ) : HR K n →ₗ[ZMod 2] ((j : Fin (n + 1)) → H K j) :=
  LinearMap.pi fun j => comp K htriv n j

include htriv in
theorem split_injective (n : ℕ) : Function.Injective (split K htriv n) := by
  rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
  intro y hy
  obtain ⟨c, rfl⟩ := Submodule.Quotient.mk_surjective _ y
  have hcomp : ∀ j : Fin (n + 1), ((c : Seq K) j) ∈ coboundaries K j := by
    intro j
    have h := congrFun hy j
    change Submodule.Quotient.mk (compCocycle K htriv n j c) = 0 at h
    have h2 := (Submodule.Quotient.mk_eq_zero _).mp h
    exact h2
  rw [mk_eq_zero_iff_bcoboundary]
  -- choose primitives of the components of positive degree
  have hprim : ∀ i : ℕ, i < n → ∃ y : K.C i, K.d i y = (c : Seq K) (i + 1) := by
    intro i hi
    exact hcomp ⟨i + 1, by omega⟩
  choose y hy using hprim
  refine ⟨fun i => if h : i < n then y i h else 0, ?_, ?_⟩
  · intro i hi
    simp [show ¬ i < n by omega]
  · funext j
    cases j with
    | zero =>
      rw [D_zero, tr_eq_zero_of_trivial K htriv]
      have h0 : (c : Seq K) 0 ∈ coboundaries K 0 := hcomp ⟨0, by omega⟩
      exact ((Submodule.mem_bot (ZMod 2)).mp h0).symm
    | succ i =>
      rw [D_succ, tr_eq_zero_of_trivial K htriv, add_zero]
      by_cases hi : i < n
      · simp only [hi, dite_true]
        exact hy i hi
      · simp only [hi, dite_false, map_zero]
        exact (((mem_bcocycles K).mp c.2).1 (i + 1) (by omega)).symm

include htriv in
theorem split_surjective (n : ℕ) : Function.Surjective (split K htriv n) := by
  intro z
  have hrep : ∀ j : Fin (n + 1), ∃ x : cocycles K j, Submodule.Quotient.mk x = z j :=
    fun j => Submodule.Quotient.mk_surjective _ (z j)
  choose x hx using hrep
  let c : Seq K := fun j => if h : j < n + 1 then ((x ⟨j, h⟩ : cocycles K j) : K.C j) else 0
  have hclow : c ∈ low K (n + 1) := by
    intro j hj
    show c j = 0
    simp only [c]
    exact dite_eq_right (show ¬ j < n + 1 by omega)
  have hcD : D K c = 0 := by
    funext j
    cases j with
    | zero =>
      rw [D_zero, tr_eq_zero_of_trivial K htriv]
      rfl
    | succ i =>
      rw [D_succ, tr_eq_zero_of_trivial K htriv, add_zero]
      change K.d i (c i) = 0
      by_cases hi : i < n + 1
      · simp only [c, hi, dite_true]
        exact (x ⟨i, hi⟩).2
      · simp only [c, hi, dite_false, map_zero]
  refine ⟨Submodule.Quotient.mk ⟨c, hclow, hcD⟩, ?_⟩
  funext j
  rw [← hx j]
  change Submodule.Quotient.mk (compCocycle K htriv n j ⟨c, hclow, hcD⟩) =
    Submodule.Quotient.mk (x j)
  congr 1
  apply Subtype.ext
  change c j = ((x j : cocycles K j) : K.C j)
  simp only [c, j.2, dite_true]

/-- For the trivial involution H_R^n is ∏_{j ≤ n} H^j (the Künneth splitting with F₂[w]). -/
def splitEquiv (n : ℕ) : HR K n ≃ₗ[ZMod 2] ((j : Fin (n + 1)) → H K j) :=
  LinearEquiv.ofBijective (split K htriv n) ⟨split_injective K htriv n, split_surjective K htriv n⟩

end Trivial

end

end Finsler.BorelIterate
