Checked type of ReversibleFinslerSphereFC.infinite_prime_images_of_dense_length_approximation: ∀ {n : ℕ}
  (F : Finsler.Geometry.ReversibleMetric n) (l : ℝ),
  0 < l →
    ∀ (K : Set ℕ) (D : ℕ),
      (∀ (N : ℕ), ∃ m ∈ K, N ≤ m ∧ m ≤ N + D) →
        (∀ (ε : ℝ),
            0 < ε →
              ∃ M,
                ∀ m ∈ K,
                  M ≤ m →
                    ∃ g,
                      ↑m * l < √(Finsler.LoopEnergy.energy F g.loop) ∧
                        √(Finsler.LoopEnergy.energy F g.loop) ≤ ↑m * l + ε) →
          (PrimeClosedGeodesicImages F).Infinite
Checked type of ReversibleFinslerSphereFC.infinite_prime_images_of_odd_length_approximation: ∀ {n : ℕ}
  (F : Finsler.Geometry.ReversibleMetric n) (l : ℝ),
  0 < l →
    (∀ (ε : ℝ),
        0 < ε →
          ∃ M,
            ∀ (m : ℕ),
              M ≤ m →
                Odd m →
                  ∃ g,
                    ↑m * l < √(Finsler.LoopEnergy.energy F g.loop) ∧
                      √(Finsler.LoopEnergy.energy F g.loop) ≤ ↑m * l + ε) →
      (PrimeClosedGeodesicImages F).Infinite
Checked type of ReversibleFinslerSphereFC.infinite_prime_images_of_odd_homology_death: ∀ {n : ℕ}
  (F : Finsler.Geometry.ReversibleMetric n),
  1 ≤ n →
    ∀ (K : Type) [inst : Field K] (l : ℝ),
      0 < l →
        (∀ (ε : ℝ),
            0 < ε →
              ∃ M,
                ∀ (m : ℕ),
                  M ≤ m →
                    Odd m →
                      ∃ a b,
                        ∃ (hma : ↑m * l < a) (hab : a ≤ b),
                          b ≤ ↑m * l + ε ∧
                            ∃ q,
                              ¬Function.Injective
                                  ⇑(CategoryTheory.ConcreteCategory.hom
                                      (Finsler.SurfaceMinimax.inclusion F K ⋯ hab q))) →
          (PrimeClosedGeodesicImages F).Infinite
Checked type of Finsler.SurfaceMinimax.exists_geodesic_of_disk_filling: ∀ {n : ℕ}
  (F : Finsler.Geometry.ReversibleMetric n),
  1 ≤ n →
    ∀ (K : Type) [inst : Field K] {c a b : ℝ},
      0 < a →
        ∀ (hca : c ≤ a) (hab : a ≤ b) {q r : ℕ},
          q ≠ r →
            ∀ (f : TauCeti.diskBoundaryPair q ⟶ Finsler.BorelLoop.pairOf ⋯)
              (j : TauCeti.diskBoundaryPair q ⟶ TauCeti.diskBoundaryPair r)
              (G : TauCeti.diskBoundaryPair r ⟶ Finsler.BorelLoop.pairOf ⋯),
              TopPair.singularHomologyMap f (↧K) q ≠ 0 →
                CategoryTheory.CategoryStruct.comp f (Finsler.BorelCrossing.incPair ⋯ ⋯) =
                    CategoryTheory.CategoryStruct.comp j G →
                  ∃ g, a ≤ √(Finsler.LoopEnergy.energy F g.loop) ∧ √(Finsler.LoopEnergy.energy F g.loop) ≤ b
Checked type of Finsler.HingstonBlocks.family_isClosedEmbedding: ∀ {n m : ℕ} {X : Type u_1} {Y : Type u_2}
  [inst : TopologicalSpace X] [inst_1 : TopologicalSpace Y] (φ : C(X × Y, Finsler.IntervalSobolev.SphereLoop n))
  (hbase :
    ∀ (x : X) (y z : Y),
      Finsler.CompactH1Alignment.basepoint (φ (x, y)) = Finsler.CompactH1Alignment.basepoint (φ (x, z)))
  [CompactSpace X] [CompactSpace Y],
  Function.Injective ⇑φ → Topology.IsClosedEmbedding ⇑(Finsler.HingstonBlocks.family φ hbase m)
Checked type of Finsler.HingstonBlocks.exists_boundary_deficit: ∀ {n : ℕ} {X : Type u_1} {Y : Type u_2}
  [inst : TopologicalSpace X] [inst_1 : TopologicalSpace Y] (φ : C(X × Y, Finsler.IntervalSobolev.SphereLoop n))
  (hbase :
    ∀ (x : X) (y z : Y),
      Finsler.CompactH1Alignment.basepoint (φ (x, y)) = Finsler.CompactH1Alignment.basepoint (φ (x, z)))
  (F : Finsler.Geometry.ReversibleMetric n) [CompactSpace X] {B : Set Y},
  IsCompact B →
    ∀ {L : ℝ},
      (∀ (z : X × Y), Finsler.SobolevEnergy.energy F (φ z) ≤ L) →
        (∀ (x : X), ∀ y ∈ B, Finsler.SobolevEnergy.energy F (φ (x, y)) < L) →
          ∃ δ,
            0 < δ ∧
              ∀ (m : ℕ) (z : X × (Fin (m + 1) → Y)),
                (∃ i, z.2 i ∈ B) →
                  Finsler.SobolevEnergy.energy F ((Finsler.HingstonBlocks.family φ hbase m) z) ≤
                    (↑m + 1) ^ 2 * L - (↑m + 1) * δ
Checked type of Finsler.HingstonBlocks.familyPairMap_apply: ∀ {n m : ℕ} {X Y : Type} [inst : TopologicalSpace X]
  [inst_1 : TopologicalSpace Y] (φ : C(X × Y, Finsler.IntervalSobolev.SphereLoop n))
  (hbase :
    ∀ (x : X) (y z : Y),
      Finsler.CompactH1Alignment.basepoint (φ (x, y)) = Finsler.CompactH1Alignment.basepoint (φ (x, z)))
  (F : Finsler.Geometry.ReversibleMetric n) {l a : ℝ} (hl : 0 < l) (ha : (↑m + 1) * l < a) {B : Set (X × Y)}
  (hL : ∀ (z : X × Y), Finsler.SobolevEnergy.energy F (φ z) ≤ l ^ 2)
  (hB : ∀ z ∈ B, Finsler.SobolevEnergy.energy F (φ z) < l ^ 2) (z : X × (Fin (m + 1) → Y)),
  ↑((CategoryTheory.ConcreteCategory.hom (TopPair.Hom.fst (Finsler.HingstonBlocks.familyPairMap φ hbase F hl ha hL hB)))
        z) =
    (Finsler.HingstonBlocks.family φ hbase m) z
Checked type of Finsler.HingstonConnectors.exists_uniform_budget: ∀ {n : ℕ} (F : Finsler.Geometry.ReversibleMetric n)
  {l δ ε : ℝ},
  0 < l →
    0 < δ →
      0 < ε →
        ∃ c ρ,
          0 < c ∧
            0 < ρ ∧
              ρ ≤ Finsler.HingstonConnectors.shortRadius F ∧
                Finsler.HingstonConnectors.overhead (l ^ 2) c < δ ∧
                  Finsler.HingstonConnectors.overhead (l ^ 2) c < 2 * l * ε ∧
                    ∀ (p : Finsler.HingstonConnectors.NearPairs F),
                      ‖Finsler.CompactH1Alignment.basepoint (↑p).2 - Finsler.CompactH1Alignment.basepoint (↑p).1‖ < ρ →
                        Finsler.SobolevSpherePath.pathEnergy F (↑(Finsler.HingstonConnectors.shortData F p)).2.2 < c ^ 2
Checked type of Finsler.HingstonConnectors.blockLoop_base_boundary_lt: ∀ {n : ℕ} {c : ℝ} (hc : 0 < c)
  (F : Finsler.Geometry.ReversibleMetric n) {r s : ℕ} (z : Finsler.HingstonConnectors.NearBlocks F r s) {L δ : ℝ},
  0 ≤ δ →
    Finsler.HingstonConnectors.overhead L c < (↑r + 1) * δ →
      Finsler.HingstonConnectors.overhead L c < (↑s + 1) * δ →
        (∀ (i : Fin (r + 1)), Finsler.SobolevEnergy.energy F (↑(↑z).1 i) ≤ L) →
          (∀ (i : Fin (s + 1)), Finsler.SobolevEnergy.energy F (↑(↑z).2 i) ≤ L) →
            ((∀ (i : Fin (r + 1)), Finsler.SobolevEnergy.energy F (↑(↑z).1 i) ≤ L - δ) ∨
                ∀ (i : Fin (s + 1)), Finsler.SobolevEnergy.energy F (↑(↑z).2 i) ≤ L - δ) →
              Finsler.SobolevSpherePath.pathEnergy F
                    (↑(Finsler.HingstonConnectors.shortData F ((Finsler.HingstonConnectors.blockPair F r s) z))).2.2 ≤
                  c ^ 2 →
                Finsler.SobolevEnergy.energy F ((Finsler.HingstonConnectors.blockLoop hc F r s) z) <
                  (↑r + 1 + (↑s + 1)) ^ 2 * L
Checked type of Finsler.HingstonPause.shortLoop_diagonal_eq: ∀ {n : ℕ} {a b c : ℝ} (ha : 0 < a) (hb : 0 < b)
  (hc : 0 < c) (F : Finsler.Geometry.ReversibleMetric n) (p : ↑(Finsler.H1JoinContinuity.composable n)),
  (Finsler.HingstonConnectors.shortLoop ha hb hc F) ((Finsler.HingstonConnectors.diagonalPairs F) p) =
    Finsler.HingstonPause.value ha hb ⟨c, ⋯⟩ p
Checked type of Finsler.HingstonPause.family_homology_eq: ∀ {n : ℕ} {a b c : ℝ} (ha : 0 < a) (hb : 0 < b) (hc : 0 ≤ c)
  (F : Finsler.Geometry.ReversibleMetric n) {X : Type} [inst : TopologicalSpace X]
  (φ : C(X, ↑(Finsler.H1JoinContinuity.composable n))) {B : Set X} {l L : ℝ} (hl : 0 < l) (hL : 0 < L) (hlL : l ≤ L)
  (hφ : ∀ (x : X), Finsler.HingstonPause.value ha hb ⟨c, hc⟩ (φ x) ∈ Finsler.BorelLoop.lev F L)
  (hB : ∀ x ∈ B, Finsler.HingstonPause.value ha hb ⟨c, hc⟩ (φ x) ∈ Finsler.BorelLoop.lev F l) (K : Type)
  [inst_1 : Field K] (q : ℕ),
  TopPair.singularHomologyMap (Finsler.HingstonPause.familyPairMap ha hb hc F φ hl hL hlL hφ hB 0) (↧K) q =
    TopPair.singularHomologyMap (Finsler.HingstonPause.familyPairMap ha hb hc F φ hl hL hlL hφ hB 1) (↧K) q
Checked type of Finsler.SurfaceMinimax.exists_geodesic_of_homotopic_disk_filling: ∀ {n : ℕ}
  (F : Finsler.Geometry.ReversibleMetric n),
  1 ≤ n →
    ∀ (K : Type) [inst : Field K] {c a b : ℝ},
      0 < a →
        ∀ (hca : c ≤ a) (hab : a ≤ b) {q r : ℕ},
          q ≠ r →
            ∀ (f : TauCeti.diskBoundaryPair q ⟶ Finsler.BorelLoop.pairOf ⋯)
              (j : TauCeti.diskBoundaryPair q ⟶ TauCeti.diskBoundaryPair r)
              (G : TauCeti.diskBoundaryPair r ⟶ Finsler.BorelLoop.pairOf ⋯),
              TopPair.singularHomologyMap f (↧K) q ≠ 0 →
                ∀
                  (H :
                    TopPair.Homotopy (CategoryTheory.CategoryStruct.comp f (Finsler.BorelCrossing.incPair ⋯ ⋯))
                      (CategoryTheory.CategoryStruct.comp j G)),
                  ∃ g, a ≤ √(Finsler.LoopEnergy.energy F g.loop) ∧ √(Finsler.LoopEnergy.energy F g.loop) ≤ b
Checked type of Finsler.HingstonFilling.block_homology_eq_zero: ∀ {n : ℕ} {Y : Type} [inst : TopologicalSpace Y]
  (F : Finsler.Geometry.ReversibleMetric n) (φ : C(Finsler.HingstonFilling.I × Y, Finsler.IntervalSobolev.SphereLoop n))
  (hbase :
    ∀ (x : Finsler.HingstonFilling.I) (y z : Y),
      Finsler.CompactH1Alignment.basepoint (φ (x, y)) = Finsler.CompactH1Alignment.basepoint (φ (x, z)))
  {ρ : ℝ} (hρ : ρ ≤ Finsler.HingstonConnectors.shortRadius F)
  (hnear :
    ∀ (x x' : Finsler.HingstonFilling.I) (y y' : Y),
      ‖Finsler.CompactH1Alignment.basepoint (φ (x', y')) - Finsler.CompactH1Alignment.basepoint (φ (x, y))‖ < ρ)
  (r s : ℕ) {c : ℝ} (hc : 0 < c)
  (hpath :
    ∀ (p : Finsler.HingstonConnectors.NearPairs F),
      ‖Finsler.CompactH1Alignment.basepoint (↑p).2 - Finsler.CompactH1Alignment.basepoint (↑p).1‖ < ρ →
        Finsler.SobolevSpherePath.pathEnergy F (↑(Finsler.HingstonConnectors.shortData F p)).2.2 ≤ c ^ 2)
  {l ε : ℝ} (hl : 0 < l) (hε : 0 < ε) (BY : Set Y) (bounds : Finsler.HingstonFilling.EnergyBounds F φ BY l ε c r s)
  (K : Type) [inst_1 : Field K] (q : ℕ),
  TopPair.singularHomologyMap (Finsler.HingstonFilling.blockPairMap F φ hbase hρ hnear r s hc hpath hl hε BY bounds)
      (↧K) q =
    0
Checked type of Finsler.SurfaceMinimax.exists_geodesic_of_block_filling: ∀ {n : ℕ}
  (F : Finsler.Geometry.ReversibleMetric n) {Y : Type} [inst : TopologicalSpace Y]
  (φ : C(Finsler.HingstonFilling.I × Y, Finsler.IntervalSobolev.SphereLoop n))
  (hbase :
    ∀ (x : Finsler.HingstonFilling.I) (y z : Y),
      Finsler.CompactH1Alignment.basepoint (φ (x, y)) = Finsler.CompactH1Alignment.basepoint (φ (x, z)))
  {ρ : ℝ} (hρ : ρ ≤ Finsler.HingstonConnectors.shortRadius F)
  (hnear :
    ∀ (x x' : Finsler.HingstonFilling.I) (y y' : Y),
      ‖Finsler.CompactH1Alignment.basepoint (φ (x', y')) - Finsler.CompactH1Alignment.basepoint (φ (x, y))‖ < ρ)
  (r s : ℕ) {c : ℝ} (hc : 0 < c)
  (hpath :
    ∀ (p : Finsler.HingstonConnectors.NearPairs F),
      ‖Finsler.CompactH1Alignment.basepoint (↑p).2 - Finsler.CompactH1Alignment.basepoint (↑p).1‖ < ρ →
        Finsler.SobolevSpherePath.pathEnergy F (↑(Finsler.HingstonConnectors.shortData F p)).2.2 ≤ c ^ 2)
  {l ε : ℝ} (hl : 0 < l) (hε : 0 < ε) (BY : Set Y) (bounds : Finsler.HingstonFilling.EnergyBounds F φ BY l ε c r s)
  {a : ℝ} (ha : (↑r + 1 + (↑s + 1)) * l < a),
  a ≤ (↑r + 1 + (↑s + 1)) * l + ε →
    1 ≤ n →
      ∀ (K : Type) [inst_1 : Field K] (q : ℕ),
        TopPair.singularHomologyMap
              (Finsler.HingstonFilling.lowerBlockPairMap F φ hbase hρ hnear r s hc hpath hl hε BY bounds ha) (↧K) q ≠
            0 →
          ∃ g,
            (↑r + 1 + (↑s + 1)) * l < √(Finsler.LoopEnergy.energy F g.loop) ∧
              √(Finsler.LoopEnergy.energy F g.loop) ≤ (↑r + 1 + (↑s + 1)) * l + ε
