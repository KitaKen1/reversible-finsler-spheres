Checked type of Finsler.SurfacePhaseGeometry.exists_transverse_splitting: ∀ {n : ℕ}
  {F : Finsler.Geometry.ReversibleMetric n} {g : Finsler.Geodesics.ClosedGeodesic F} {a : ℝ}
  (D : GeodesicPhaseModel F g a),
  ∃ σ e,
    ContDiffAt ℝ 2 σ 0 ∧
      σ 0 = 0 ∧
        0 ∈ e.source ∧
          ↑e 0 = 0 ∧
            ∀ w ∈ e.source,
              transverseEnergy D w =
                transverseEnergy D (σ ((Finsler.LyapunovSchmidt.kerProj (transverseHessian D)) (↑e w))) +
                  1 / 2 * ⟪(transverseHessian D) (↑e w), ↑e w⟫
