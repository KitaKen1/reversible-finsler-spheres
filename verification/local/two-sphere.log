  [inst : TopologicalSpace X] [inst_1 : TopologicalSpace Y] (E : X → ℝ) (G : Y → ℝ) (p : X) (p' : Y) (f : C(X, Y)),
  f p = p' →
    (∀ (x : X), E x < E p → G (f x) < G p') →
      ∀ (V : Set Y) (hpV : p' ∈ V) (r : C(↑V, X)) (hrp : r ⟨p', hpV⟩ = p) (hr : ∀ (y : ↑V), G ↑y < G p' → E (r y) < E p)
        (H : C(↑unitInterval × ↑V, Y)),
        (∀ (y : ↑V), H (0, y) = ↑y) →
          (∀ (y : ↑V), H (1, y) = f (r y)) →
            (∀ (t : ↑unitInterval), H (t, ⟨p', hpV⟩) = p') →
              (∀ (t : ↑unitInterval) (y : ↑V), G (H (t, y)) ≤ G ↑y) →
                Continuous G →
                  IsOpen V →
                    ∀ (K : Type) [inst_2 : Field K] (q : ℕ),
                      Function.Injective
                        ⇑(CategoryTheory.ConcreteCategory.hom
                            (TopPair.singularHomologyMap
                              (Finsler.SurfaceIterationHomology.criticalMap (fun y => G ↑y) E ⟨p', hpV⟩ p r hrp hr) (↧K)
                              q))
