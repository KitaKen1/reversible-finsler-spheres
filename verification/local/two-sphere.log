  index F (P.iterated m).point ⋯ = index F P.point ⋯ →
    ∀ v ∈ (Finsler.PolygonNormal.iterSpace m N)ᗮ, 0 ≤ ⟪(hessian F (P.iterated m).point) v, v⟫
