Checked type of Finsler.SurfacePolygonHomology.localDiskToLoops_class_ne_zero: ∀ {n N : ℕ}
  {F : Finsler.Geometry.ReversibleMetric n} {a : ℝ} [inst : NeZero N] (M : Finsler.PolygonModel.PolygonModelData F a N)
  {q : ℕ} (U : Set (Short M)) (f : C(Finsler.SurfaceLocalHomology.Disk q, ↑U))
  (hmax :
    ∀ (x : Finsler.SurfaceLocalHomology.Disk q),
      x ≠ Finsler.SurfaceLocalHomology.center q →
        polygonEnergy M ↑(f x) < polygonEnergy M ↑(f (Finsler.SurfaceLocalHomology.center q))),
  IsOpen U →
    polygonEnergy M ↑(f (Finsler.SurfaceLocalHomology.center q)) < a ^ 2 →
      ∀ (r : C(↑U, Finsler.SurfaceLocalHomology.Disk q)),
        (∀ (x : ↑U),
            r x = Finsler.SurfaceLocalHomology.center q →
              polygonEnergy M ↑(f (Finsler.SurfaceLocalHomology.center q)) ≤ polygonEnergy M ↑x) →
          (∀ (x : Finsler.SurfaceLocalHomology.Disk q), r (f x) = x) →
            ∀ (K : Type) [inst_1 : Field K],
              (CategoryTheory.ConcreteCategory.hom (TopPair.singularHomologyMap (localDiskToLoops M U f hmax) (↧K) q))
                  (Finsler.SurfaceLocalHomology.diskClass q K) ≠
                0
