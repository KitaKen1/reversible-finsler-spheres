Checked type of ReversibleFinslerSphereFC.infinite_prime_images_of_dense_length_approximation: ∀ {n : ℕ}
  (F : Finsler.Geometry.ReversibleMetric n) (l : ℝ),
  0 < l →
    ∀ (K : Set ℕ) (D : ℕ),
      (∀ (N : ℕ), ∃ m ∈ K, N ≤ m ∧ m ≤ N + D) →
        (∀ (ε : ℝ),
            0 < ε →
              ∃ M,
                ∀ m ∈ K,
                  M ≤ m →
                    ∃ g,
                      ↑m * l < √(Finsler.LoopEnergy.energy F g.loop) ∧
                        √(Finsler.LoopEnergy.energy F g.loop) ≤ ↑m * l + ε) →
          (PrimeClosedGeodesicImages F).Infinite
Checked type of ReversibleFinslerSphereFC.infinite_prime_images_of_odd_length_approximation: ∀ {n : ℕ}
  (F : Finsler.Geometry.ReversibleMetric n) (l : ℝ),
  0 < l →
    (∀ (ε : ℝ),
        0 < ε →
          ∃ M,
            ∀ (m : ℕ),
              M ≤ m →
                Odd m →
                  ∃ g,
                    ↑m * l < √(Finsler.LoopEnergy.energy F g.loop) ∧
                      √(Finsler.LoopEnergy.energy F g.loop) ≤ ↑m * l + ε) →
      (PrimeClosedGeodesicImages F).Infinite
Checked type of ReversibleFinslerSphereFC.infinite_prime_images_of_odd_homology_death: ∀ {n : ℕ}
  (F : Finsler.Geometry.ReversibleMetric n),
  1 ≤ n →
    ∀ (K : Type) [inst : Field K] (l : ℝ),
      0 < l →
        (∀ (ε : ℝ),
            0 < ε →
              ∃ M,
                ∀ (m : ℕ),
                  M ≤ m →
                    Odd m →
                      ∃ a b,
                        ∃ (hma : ↑m * l < a) (hab : a ≤ b),
                          b ≤ ↑m * l + ε ∧
                            ∃ q,
                              ¬Function.Injective
                                  ⇑(CategoryTheory.ConcreteCategory.hom
                                      (Finsler.SurfaceMinimax.inclusion F K ⋯ hab q))) →
          (PrimeClosedGeodesicImages F).Infinite
Checked type of Finsler.SurfaceMinimax.exists_geodesic_of_disk_filling: ∀ {n : ℕ}
  (F : Finsler.Geometry.ReversibleMetric n),
  1 ≤ n →
    ∀ (K : Type) [inst : Field K] {c a b : ℝ},
      0 < a →
        ∀ (hca : c ≤ a) (hab : a ≤ b) {q r : ℕ},
          q ≠ r →
            ∀ (f : TauCeti.diskBoundaryPair q ⟶ Finsler.BorelLoop.pairOf ⋯)
              (j : TauCeti.diskBoundaryPair q ⟶ TauCeti.diskBoundaryPair r)
              (G : TauCeti.diskBoundaryPair r ⟶ Finsler.BorelLoop.pairOf ⋯),
              TopPair.singularHomologyMap f (↧K) q ≠ 0 →
                CategoryTheory.CategoryStruct.comp f (Finsler.BorelCrossing.incPair ⋯ ⋯) =
                    CategoryTheory.CategoryStruct.comp j G →
                  ∃ g, a ≤ √(Finsler.LoopEnergy.energy F g.loop) ∧ √(Finsler.LoopEnergy.energy F g.loop) ≤ b
Checked type of Finsler.HingstonBlocks.family_isClosedEmbedding: ∀ {n m : ℕ} {X : Type u_1} {Y : Type u_2}
  [inst : TopologicalSpace X] [inst_1 : TopologicalSpace Y] (φ : C(X × Y, Finsler.IntervalSobolev.SphereLoop n))
  (hbase :
    ∀ (x : X) (y z : Y),
