Checked type of Finsler.SurfaceIterationHomology.criticalMap_injective_of_local_retraction: ∀ {X Y : Type}
  [inst : TopologicalSpace X] [inst_1 : TopologicalSpace Y] {E : X → ℝ} {H : Y → ℝ} {p : X} {p' : Y},
  Continuous E →
    Continuous H →
      ∀ (f : C(X, Y)) (hp : f p = p') (hf : ∀ (x : X), E x < E p → H (f x) < H p') (V : Set Y),
        IsOpen V →
          p' ∈ V →
            ∀ (r : C(↑V, X)),
              (∀ (x : X) (hx : f x ∈ V), r ⟨f x, hx⟩ = x) →
                (∀ (y : ↑V), H ↑y < H p' → E (r y) < E p) →
                  ∀ (K : Type) [inst_2 : Field K] (j : ℕ),
                    Function.Injective
                      ⇑(CategoryTheory.ConcreteCategory.hom
                          (TopPair.singularHomologyMap (Finsler.SurfaceIterationHomology.criticalMap E H p p' f hp hf)
                            (↧K) j))
