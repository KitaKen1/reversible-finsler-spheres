  (hv : T v = 0), v ≠ 0 → Module.finrank ℝ ↥(↑(phaseRestriction v hv)).ker + 1 = Module.finrank ℝ ↥(↑T).ker
Checked type of Finsler.SurfacePhaseGeometry.axisEquiv_apply: ∀ {E : Type} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] (v : E) (hv : v ≠ 0) (t : ℝ) (w : ↥(phaseSlice v)),
  (axisEquiv v hv) (t, w) = t • v + ↑w
Checked type of Finsler.SurfacePhaseGeometry.exists_straightening: ∀ {E : Type} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [FiniteDimensional ℝ E] (c : ℝ → E),
  ContDiffAt ℝ ∞ c 0 →
    c 0 = 0 →
      ∀ {v : E},
        HasDerivAt c v 0 →
          v ≠ 0 →
            ∃ e,
              0 ∈ e.source ∧
                ↑e 0 = 0 ∧
                  (∀ (y : ℝ × ↥(phaseSlice v)), ↑e.symm y = c y.1 + ↑y.2) ∧
                    ∀ᶠ (t : ℝ) in 𝓝 0, c t ∈ e.source ∧ ↑e (c t) = (t, 0)
