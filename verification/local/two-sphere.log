  (z : Finsler.PolygonChart.Model n (m * N)),
  Finsler.PolygonChart.energy F (P.iterated m).point
      (Finsler.PolygonChart.base (P.iterated m).point +
        (Finsler.MorseBott.tanProj (Finsler.PolygonNormal.iterSpace m N)) z) =
    ↑m ^ 2 *
      Finsler.PolygonChart.energy F P.point
