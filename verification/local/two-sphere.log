  v ∈ hT.eigenvectorSpan ⋯ s → ∀ {i : Fin (Module.finrank ℝ E)}, i ∉ s → ((hT.eigenvectorBasis ⋯).repr v).ofLp i = 0
Checked type of Finsler.SurfaceSpectralDisk.inner_eq_sum: ∀ {E : Type} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] (T : E →L[ℝ] E) (hT : (↑T).IsSymmetric) (v w : E),
  ⟪v, w⟫ = ∑ i, ((hT.eigenvectorBasis ⋯).repr v).ofLp i * ((hT.eigenvectorBasis ⋯).repr w).ofLp i
Checked type of Finsler.SurfaceSpectralDisk.quadratic_eq_sum: ∀ {E : Type} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] (T : E →L[ℝ] E) (hT : (↑T).IsSymmetric) (v : E),
  ⟪T v, v⟫ = ∑ i, hT.eigenvalues ⋯ i * ((hT.eigenvectorBasis ⋯).repr v).ofLp i ^ 2
Checked type of Finsler.SurfaceSpectralDisk.spectral_inner_eq_zero: ∀ {E : Type} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] (T : E →L[ℝ] E) (hT : (↑T).IsSymmetric)
  {s t : Set (Fin (Module.finrank ℝ E))},
  Disjoint s t → ∀ {v w : E}, v ∈ hT.eigenvectorSpan ⋯ s → w ∈ hT.eigenvectorSpan ⋯ t → ⟪v, w⟫ = 0
Checked type of Finsler.SurfaceSpectralDisk.nonpositive_eq: ∀ {E : Type} [inst : NormedAddCommGroup E]
