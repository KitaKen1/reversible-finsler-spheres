Checked type of Finsler.SurfaceSpectralDisk.reducedPart_strict_max: ∀ {E : Type} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] (T : E →L[ℝ] E) (hT : (↑T).IsSymmetric) (R : E → ℝ),
  (∀ᶠ (z : ↥(↑T).ker) in 𝓝 0, z ≠ 0 → R ↑z < R 0) →
    ∀ᶠ (u : ↥(nonpositive T hT)) in 𝓝 0, u ≠ 0 → reducedPart T hT R u < reducedPart T hT R 0
Checked type of Finsler.SurfaceSpectralDisk.energy_split: ∀ {E : Type} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] (T : E →L[ℝ] E) (hT : (↑T).IsSymmetric) (R : E → ℝ)
  (u : ↥(nonpositive T hT)) (v : ↥(Finsler.HessianSplitting.positive T hT)),
  R ((Finsler.LyapunovSchmidt.kerProj T) (↑u + ↑v)) + 1 / 2 * ⟪T (↑u + ↑v), ↑u + ↑v⟫ =
    reducedPart T hT R u + 1 / 2 * ⟪T ↑v, ↑v⟫
Checked type of Finsler.SurfaceSpectralDisk.diskCoordinates_symm_apply: ∀ {E : Type} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] (T : E →L[ℝ] E) (hT : (↑T).IsSymmetric)
  (u : EuclideanSpace ℝ (Fin (Module.finrank ℝ ↥(nonpositive T hT)))) (v : ↥(Finsler.HessianSplitting.positive T hT)),
  (diskCoordinates T hT).symm (u, v) = ↑((stdOrthonormalBasis ℝ ↥(nonpositive T hT)).repr.symm u) + ↑v
Checked type of Finsler.SurfaceSpectralDisk.nonempty_maximalDiskData_of_spectralSplitting: ∀ {E : Type}
  [inst : NormedAddCommGroup E] [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] (T : E →L[ℝ] E)
  (hT : (↑T).IsSymmetric) {X : Type} [inst_3 : TopologicalSpace X] (energy : X → ℝ) (p : X)
  (e : OpenPartialHomeomorph X E),
  p ∈ e.source →
    ↑e p = 0 →
      ∀ (R : E → ℝ),
        (∀ x ∈ e.source, energy x = R ((Finsler.LyapunovSchmidt.kerProj T) (↑e x)) + 1 / 2 * ⟪T (↑e x), ↑e x⟫) →
          (∀ᶠ (z : ↥(↑T).ker) in 𝓝 0, z ≠ 0 → R ↑z < R 0) →
            Nonempty (Finsler.SurfaceMorseData.MaximalDiskData energy p (Module.finrank ℝ ↥(nonpositive T hT)))
