Checked type of Finsler.SurfaceMorseData.exists_short_splitting: ∀ {n N : ℕ} {F : Finsler.Geometry.ReversibleMetric n}
  {a : ℝ} [inst : NeZero N] (M : Finsler.PolygonModel.PolygonModelData F a N) (p : Short M),
  (∀ (i : ZMod N), ↑p (i + 1) ≠ ↑p i) →
    Finsler.PolygonCritical.PolyCritical F N ↑p →
      ∃ σ e,
        ContDiffAt ℝ 2 σ 0 ∧
          σ 0 = 0 ∧
            p ∈ e.source ∧
              ↑e p = 0 ∧
                ∀ x ∈ e.source,
                  polygonEnergy M x =
                    Finsler.PolygonChart.energy F (↑p)
                        (Finsler.PolygonChart.base ↑p + σ ((Finsler.LyapunovSchmidt.kerProj (hessian F ↑p)) (↑e x))) +
                      1 / 2 * ⟪(hessian F ↑p) (↑e x), ↑e x⟫
