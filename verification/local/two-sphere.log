Checked type of Finsler.SurfacePhaseGeometry.actual_phase_nullity: ∀ {n : ℕ} {F : Finsler.Geometry.ReversibleMetric n}
  {g : Finsler.Geodesics.ClosedGeodesic F} {a : ℝ} (D : GeodesicPhaseModel F g a),
  Module.finrank ℝ ↥(↑(phaseRestriction (phaseVector D.vertices g.loop) ⋯)).ker + 1 = nullity F ↑(phasePoint D 0)
Checked type of Finsler.SurfacePhaseGeometry.exists_phaseChart: ∀ {n : ℕ} {F : Finsler.Geometry.ReversibleMetric n}
  {g : Finsler.Geodesics.ClosedGeodesic F} {a : ℝ} (D : GeodesicPhaseModel F g a),
  ∃ e,
    phasePoint D 0 ∈ e.source ∧
      ↑e (phasePoint D 0) = 0 ∧
        (∀ x ∈ e.source, x ∈ (Finsler.SurfaceMorseData.centeredChart D.model (phasePoint D 0)).source) ∧
          (∀ y ∈ e.target,
              ↑(Finsler.SurfaceMorseData.centeredChart D.model (phasePoint D 0)) (↑e.symm y) =
                phaseCoordinates D.vertices g.loop y.1 + ↑y.2) ∧
            ∀ᶠ (t : ℝ) in 𝓝 0, phasePoint D t ∈ e.source ∧ ↑e (phasePoint D t) = (t, 0)
Checked type of Finsler.SurfacePhaseGeometry.exists_phaseChart_energy: ∀ {n : ℕ}
  {F : Finsler.Geometry.ReversibleMetric n} {g : Finsler.Geodesics.ClosedGeodesic F} {a : ℝ}
  (D : GeodesicPhaseModel F g a),
  ∃ e,
    phasePoint D 0 ∈ e.source ∧
      ↑e (phasePoint D 0) = 0 ∧
        (∀ (w : ↥(phaseSlice (phaseVector D.vertices g.loop))),
            (0, w) ∈ e.target →
              polygonEnergy D.model (↑e.symm (0, w)) = transverseEnergy D w ∧
                Finsler.SobolevEnergy.energy F (Finsler.PolygonModel.broken D.model (↑e.symm (0, w))) =
                  transverseEnergy D w) ∧
          ∀ᶠ (t : ℝ) in 𝓝 0, phasePoint D t ∈ e.source ∧ ↑e (phasePoint D t) = (t, 0)
