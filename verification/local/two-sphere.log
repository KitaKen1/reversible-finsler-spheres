Checked type of Finsler.SurfaceIterationEquivalence.exists_polygon_deformation_with_projection: ∀ {n N : ℕ}
  [inst : NeZero N] {F : Finsler.Geometry.ReversibleMetric n} (P : Finsler.SurfaceIteration.PolygonSlice F N) (m : ℕ)
  [inst_1 : NeZero m],
  nullity F (P.iterated m).point ≤ nullity F P.point →
    index F (P.iterated m).point ⋯ = index F P.point ⋯ →
      ∃ V,
        ∃ (hpV : (P.iterated m).point ∈ V),
          IsOpen V ∧
            ∃ r,
              r ⟨(P.iterated m).point, hpV⟩ = P.point ∧
                (∀ (y : ↑V),
                    ↑m ^ 2 * Finsler.PolygonDescent.energy F N (r y) ≤ Finsler.PolygonDescent.energy F (m * N) ↑y) ∧
                  (∀ (y : ↑V),
                      r y =
                        ↑(Finsler.SurfaceIterationHomology.centeredPolygonChart P.point).symm
                          ((Finsler.PolygonNormal.resL m N)
                            ((Finsler.MorseBott.tanProj (Finsler.PolygonNormal.iterSpace m N))
                              (↑(Finsler.SurfaceIterationHomology.centeredPolygonChart (P.iterated m).point) ↑y)))) ∧
                    ∃ H,
                      (∀ (y : ↑V), H (0, y) = ↑y) ∧
                        (∀ (y : ↑V), H (1, y) = (Finsler.SurfaceIterationHomology.polygonIteration m) (r y)) ∧
                          (∀ (t : ↑unitInterval), H (t, ⟨(P.iterated m).point, hpV⟩) = (P.iterated m).point) ∧
                            ∀ (t : ↑unitInterval) (y : ↑V),
                              Finsler.PolygonDescent.energy F (m * N) (H (t, y)) ≤
                                Finsler.PolygonDescent.energy F (m * N) ↑y
