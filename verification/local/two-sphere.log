  v ∈ nonpositive T hT → (⟪T v, v⟫ = 0 ↔ T v = 0)
Checked type of Finsler.SurfaceSpectralDisk.finrank_nonpositive: ∀ {E : Type} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] (T : E →L[ℝ] E) (hT : (↑T).IsSymmetric),
  Module.finrank ℝ ↥(nonpositive T hT) =
