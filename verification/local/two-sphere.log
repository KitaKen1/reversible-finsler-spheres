Checked type of Finsler.SurfaceSpectralDisk.reducedPart_zero: ∀ {E : Type} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] (T : E →L[ℝ] E) (hT : (↑T).IsSymmetric) (R : E → ℝ),
