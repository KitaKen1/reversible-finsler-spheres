  (q r : ZMod N → Finsler.SphereGeometry.Sphere n),
  r ∈ (Finsler.PolygonChart.chart q).source →
    Finsler.PolygonLoop.ShortPolygon S.δ r →
      (∀ (i : ZMod N), r (i + 1) ≠ r i) →
        Finsler.PolygonCritical.PolyCritical F N r → grad F q (↑(Finsler.PolygonChart.chart q) r) = 0
Checked type of Finsler.SurfacePhaseGeometry.phaseCoordinates_gradient_zero: ∀ {n N : ℕ} [inst : NeZero N]
