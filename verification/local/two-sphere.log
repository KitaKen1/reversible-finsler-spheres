Checked type of Finsler.HingstonBlocks.exists_boundary_deficit: ∀ {n : ℕ} {X : Type u_1} {Y : Type u_2}
  [inst : TopologicalSpace X] [inst_1 : TopologicalSpace Y] (φ : C(X × Y, Finsler.IntervalSobolev.SphereLoop n))
  (hbase :
    ∀ (x : X) (y z : Y),
