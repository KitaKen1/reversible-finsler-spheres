  nonpositive T hT = Finsler.HessianSplitting.negative T hT ⊔ (↑T).ker
Checked type of Finsler.SurfaceSpectralDisk.nonpositive_isCompl_positive: ∀ {E : Type} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] (T : E →L[ℝ] E) (hT : (↑T).IsSymmetric),
