  {F : Finsler.Geometry.ReversibleMetric n} {g : Finsler.Geodesics.ClosedGeodesic F} {a : ℝ}
  (D : GeodesicPhaseModel F g a), transverseGradient D 0 = 0
Checked type of Finsler.SurfacePhaseGeometry.transverseGradient_hasFDerivAt: ∀ {n : ℕ}
  {F : Finsler.Geometry.ReversibleMetric n} {g : Finsler.Geodesics.ClosedGeodesic F} {a : ℝ}
  (D : GeodesicPhaseModel F g a), HasFDerivAt (transverseGradient D) (transverseHessian D) 0
Checked type of Finsler.SurfacePhaseGeometry.transverseEnergy_eventually_hasFDerivAt: ∀ {n : ℕ}
  {F : Finsler.Geometry.ReversibleMetric n} {g : Finsler.Geodesics.ClosedGeodesic F} {a : ℝ}
  (D : GeodesicPhaseModel F g a),
  ∀ᶠ (w : ↥(phaseSlice (phaseVector D.vertices g.loop))) in 𝓝 0,
    HasFDerivAt (transverseEnergy D) ((innerSL ℝ) (transverseGradient D w)) w
Checked type of Finsler.SurfacePhaseGeometry.transverseHessian_eq_operator: ∀ {n : ℕ}
  {F : Finsler.Geometry.ReversibleMetric n} {g : Finsler.Geodesics.ClosedGeodesic F} {a : ℝ}
  (D : GeodesicPhaseModel F g a), transverseHessian D = Finsler.Hessian.operator (transverseEnergy D) 0
Checked type of Finsler.SurfacePhaseGeometry.exists_transverse_splitting: ∀ {n : ℕ}
  {F : Finsler.Geometry.ReversibleMetric n} {g : Finsler.Geodesics.ClosedGeodesic F} {a : ℝ}
  (D : GeodesicPhaseModel F g a),
  ∃ σ e,
    ContDiffAt ℝ 2 σ 0 ∧
      σ 0 = 0 ∧
        0 ∈ e.source ∧
          ↑e 0 = 0 ∧
            ∀ w ∈ e.source,
              transverseEnergy D w =
                transverseEnergy D (σ ((Finsler.LyapunovSchmidt.kerProj (transverseHessian D)) (↑e w))) +
                  1 / 2 * ⟪(transverseHessian D) (↑e w), ↑e w⟫
Checked type of Finsler.SurfaceIteration.phaseRestriction_index: ∀ {E : Type} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] {T : E →L[ℝ] E} (hs : (↑T).IsSymmetric) (v : E)
  (hv : T v = 0),
  Module.finrank ℝ ↥(Finsler.HessianSplitting.negative (phaseRestriction v hv) ⋯) =
