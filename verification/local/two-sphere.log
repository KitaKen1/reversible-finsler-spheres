  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] {f : E → ℝ} {G : E → E} {p : E} (v : E),
  (∀ᶠ (x : E) in 𝓝 p, HasFDerivAt f ((innerSL ℝ) (G x)) x) →
