      HasFDerivAt (Finsler.SurfaceIteration.sliceEnergy f p v)
        ((innerSL ℝ) (Finsler.SurfaceIteration.sliceGradient G p v w)) w
Checked type of Finsler.SurfaceIteration.nonempty_reductionData: ∀ {E : Type} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] {A : E →L[ℝ] E} (hs : (↑A).IsSymmetric) {G : E → E},
  ContDiffAt ℝ 2 G 0 → HasFDerivAt G A 0 → G 0 = 0 → Nonempty (Finsler.SurfaceIteration.ReductionData A hs G)
Checked type of Finsler.SurfaceIteration.ReductionData.exists_splitting: ∀ {E : Type} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] {A : E →L[ℝ] E} (hs : (↑A).IsSymmetric) {G : E → E}
  (D : Finsler.SurfaceIteration.ReductionData A hs G),
  ContDiffAt ℝ 2 G 0 →
    HasFDerivAt G A 0 →
      G 0 = 0 →
        ∀ {f : E → ℝ},
          (∀ᶠ (x : E) in 𝓝 0, HasFDerivAt f ((innerSL ℝ) (G x)) x) →
            ∃ e,
              0 ∈ e.source ∧
                ↑e 0 = 0 ∧
                  ∀ x ∈ e.source,
                    f x = f (D.reduction ((Finsler.LyapunovSchmidt.kerProj A) (↑e x))) + 1 / 2 * ⟪A (↑e x), ↑e x⟫
Checked type of Finsler.SurfaceIteration.ReductionData.maximalDisk: ∀ {E : Type} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] {A : E →L[ℝ] E} (hs : (↑A).IsSymmetric) {G : E → E}
  (D : Finsler.SurfaceIteration.ReductionData A hs G),
  ContDiffAt ℝ 2 G 0 →
    HasFDerivAt G A 0 →
      G 0 = 0 →
        ∀ {f : E → ℝ},
          (∀ᶠ (x : E) in 𝓝 0, HasFDerivAt f ((innerSL ℝ) (G x)) x) →
            (∀ᶠ (z : ↥(↑A).ker) in 𝓝 0, z ≠ 0 → f (D.reduction ↑z) < f (D.reduction 0)) →
              Nonempty
                (Finsler.SurfaceMorseData.MaximalDiskData f 0
                  (Module.finrank ℝ ↥(Finsler.HessianSplitting.negative A hs) + Module.finrank ℝ ↥(↑A).ker))
Checked type of Finsler.SurfaceIteration.strict_max_of_equiv: ∀ {K₀ K : Type} [inst : NormedAddCommGroup K₀]
  [inst_1 : NormedSpace ℝ K₀] [inst_2 : NormedAddCommGroup K] [inst_3 : NormedSpace ℝ K] (e : K₀ ≃L[ℝ] K) {R₀ : K₀ → ℝ}
  {R : K → ℝ} {d : ℝ},
