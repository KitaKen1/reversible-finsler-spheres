  (hL : ∀ (z : X × Y), Finsler.SobolevEnergy.energy F (φ z) ≤ l ^ 2)
  (hB : ∀ z ∈ B, Finsler.SobolevEnergy.energy F (φ z) < l ^ 2) (z : X × (Fin (m + 1) → Y)),
