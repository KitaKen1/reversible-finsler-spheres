Checked type of Finsler.SurfaceIterationEquivalence.quadratic_segment_le: ∀ {E : Type} [inst : NormedAddCommGroup E]
  [inst_1 : InnerProductSpace ℝ E] (A : E →L[ℝ] E) (K : Submodule ℝ E),
  (∀ v ∈ K, 0 ≤ ⟪A v, v⟫) →
    ∀ (x y : E),
      x ∈ K →
        y ∈ K → ⟪A y, y⟫ = 0 → ∀ (t : ↑unitInterval), ⟪A ((1 - ↑t) • x + ↑t • y), (1 - ↑t) • x + ↑t • y⟫ ≤ ⟪A x, x⟫
Checked type of Finsler.SurfaceIterationEquivalence.exists_normal_deformation: ∀ {E : Type}
  [inst : NormedAddCommGroup E] [inst_1 : InnerProductSpace ℝ E] [inst_2 : FiniteDimensional ℝ E] (f : E → ℝ)
  (K : Submodule ℝ E) (A : E →L[ℝ] E) (e : OpenPartialHomeomorph E E),
  0 ∈ e.source →
    ↑e 0 = 0 →
      (∀ᶠ (z : E) in 𝓝 0, (Finsler.MorseBott.tanProj K) (↑e z) = (Finsler.MorseBott.tanProj K) z) →
        (∀ᶠ (z : E) in 𝓝 0,
            f z =
              f ((Finsler.MorseBott.tanProj K) z) +
                1 / 2 * ⟪A ((Finsler.MorseBott.norProj K) (↑e z)), (Finsler.MorseBott.norProj K) (↑e z)⟫) →
          (∀ v ∈ Kᗮ, 0 ≤ ⟪A v, v⟫) →
            ∀ (Ω : Set E),
              IsOpen Ω →
                0 ∈ Ω →
                  ∃ V,
                    ∃ (hV0 : 0 ∈ V),
                      IsOpen V ∧
                        V ⊆ Ω ∧
                          ∃ H,
                            (∀ (z : ↑V), ↑(H (0, z)) = ↑z) ∧
                              (∀ (z : ↑V), ↑(H (1, z)) = (Finsler.MorseBott.tanProj K) ↑z) ∧
                                (∀ (t : ↑unitInterval), ↑(H (t, ⟨0, hV0⟩)) = 0) ∧
                                  ∀ (t : ↑unitInterval) (z : ↑V), f ↑(H (t, z)) ≤ f ↑z
Checked type of Finsler.SurfaceIterationEquivalence.criticalMap_surjective_of_local_deformation: ∀ {X Y : Type}
  [inst : TopologicalSpace X] [inst_1 : TopologicalSpace Y] (E : X → ℝ) (G : Y → ℝ) (p : X) (p' : Y) (f : C(X, Y))
  (hfp : f p = p') (hf : ∀ (x : X), E x < E p → G (f x) < G p') (V : Set Y) (hpV : p' ∈ V) (r : C(↑V, X)),
  r ⟨p', hpV⟩ = p →
    (∀ (y : ↑V), G ↑y < G p' → E (r y) < E p) →
      ∀ (H : C(↑unitInterval × ↑V, Y)),
        (∀ (y : ↑V), H (0, y) = ↑y) →
          (∀ (y : ↑V), H (1, y) = f (r y)) →
            (∀ (t : ↑unitInterval), H (t, ⟨p', hpV⟩) = p') →
              (∀ (t : ↑unitInterval) (y : ↑V), G (H (t, y)) ≤ G ↑y) →
                Continuous G →
                  IsOpen V →
                    ∀ (K : Type) [inst_2 : Field K] (q : ℕ),
                      Function.Surjective
                        ⇑(CategoryTheory.ConcreteCategory.hom
                            (TopPair.singularHomologyMap
                              (Finsler.SurfaceIterationHomology.criticalMap E G p p' f hfp hf) (↧K) q))
