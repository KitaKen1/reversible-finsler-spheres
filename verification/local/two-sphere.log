  (u : ↥(nonpositive T hT)) (v : ↥(Finsler.HessianSplitting.positive T hT)), (splitEquiv T hT).symm (u, v) = ↑u + ↑v
Checked type of Finsler.SurfaceSpectralDisk.nonpositive_inner_positive: ∀ {E : Type} [inst : NormedAddCommGroup E]
