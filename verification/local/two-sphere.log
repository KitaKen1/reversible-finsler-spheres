                      (∀ (y : ↑V), H (1, y) = (Finsler.SurfaceIterationHomology.polygonIteration m) (r y)) ∧
                        (∀ (t : ↑unitInterval), H (t, ⟨(P.iterated m).point, hpV⟩) = (P.iterated m).point) ∧
                          ∀ (t : ↑unitInterval) (y : ↑V),
