theorem ReversibleFinslerSphereFC.finsler_all_dimensions_of_two_sphere : FinslerTwoSphereAssertion →
  FinslerAllDimensionsAssertion :=
fun h2 n hn F =>
  if h : n = 2 then
    Eq.ndrec (motive := fun n =>
      2 ≤ n → ∀ (F : Finsler.Geometry.ReversibleMetric n), (PrimeClosedGeodesicImages F).Infinite) (fun hn F => h2 F)
      (Eq.symm h) hn F
  else
    infinitely_many_prime_closed_geodesics n
      (Decidable.byContradiction fun a => finsler_all_dimensions_of_two_sphere._proof_1 n hn h a) F
theorem ReversibleFinslerSphereFC.riemannian_all_dimensions_of_two_sphere : FinslerTwoSphereAssertion →
  RiemannianAllDimensionsAssertion :=
fun h2 => riemannian_all_dimensions_of_finsler (finsler_all_dimensions_of_two_sphere h2)
